<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则：工时与账目是明文财务数据，既不上云备份，
  也不参与设备间直传。用户要迁移就导出 JSON，由用户自己决定文件去向。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
